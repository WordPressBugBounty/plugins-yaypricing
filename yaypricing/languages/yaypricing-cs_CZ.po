msgstr "Poskytuje 30% slevu na celou objednávku zákazníka při nákupu 3 nebo více položek."

#: includes/class-yaydp-i18n.php:123
msgid "Store could offer a 30% discount for the 3rd purchased T-Shirt or Cap"
msgstr "Obchod může nabídnout 30% slevu na 3. zakoupené tričko nebo čepici"

#: includes/class-yaydp-i18n.php:124
msgid "Flexible promotional offer that allows you to apply a discount to the entire shopping cart based on custom rules that you define."
