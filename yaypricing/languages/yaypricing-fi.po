#: includes/class-yaydp-i18n.php:147
msgid "Get free shipping"
msgstr "Saat maksuttoman toimituksen"

#: includes/class-yaydp-i18n.php:148
msgid "Offers customers free delivery on their orders under certain conditions."
msgstr "Tarjoaa asiakkaille ilmaisen toimituksen tilauksilleen tietyin ehdoin."

